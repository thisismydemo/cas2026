="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="730" y="262" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="596" y="400" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="636" y="540" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="826" y="676" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="728" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1106" y="728" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="926" y="676" width="28" height="28" as="geometry" /></mxCell><mxCell id="steps-bg" value="" style="rounded=0;html=1;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1360" height="200" as="geometry" /></mxCell><mxCell id="legend-1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="1025" width="30" height="30" as="geometry" /></mxCell><mxCell id="legend-1-text" value="&lt;b&gt;Order.&lt;/b&gt; A customer opens the portal and places an order." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1"><mxGeometry x="102" y="1020" width="620" height="40" as="geometry" /></mxCell><mxCell id="legend-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="30" height="30" as="geometry" /></mxCell><mxCell id="legend-2-text" value="&lt;b&gt;Two portals.&lt;/b&gt; Front Door serves the portal from Azure or AWS; either copy can take the order." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1"><mxGeometry x="102" y="1065" width="620" height="40" as="geometry" /></mxCell><mxCell id="legend-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="1115" width="30" height="30" as="geometry" /></mxCell><mxCell id="legend-3-text" value="&lt;b&gt;Coordinate.&lt;/b&gt; The Azure coordinator gives the order one correlation ID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1"><mxGeometry x="102" y="1110" width="620" height="40" as="geometry" /></mxCell><mxCell id="legend-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="1160" width="30" height="30" as="geometry" /></mxCell><mxCell id="legend-4-text" value="&lt;b&gt;Dispatch.&lt;/b&gt; It puts the work on Service Bus queues." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1"><mxGeometry x="102" y="1155" width="620" height="40" as="geometry" /></mxCell><mxCell id="legend-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="1025" width="30" height="30" as="geometry" /></mxCell><mxCell id="legend-5-text" value="&lt;b&gt;Validate on-premises.&lt;/b&gt; The on-premises worker pulls its work over outbound 443 and validates the order." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1"><mxGeometry x="782" y="1020" width="620" height="40" as="geometry" /></mxCell><mxCell id="legend-6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="1070" width="30" height="30" as="geometry" /></mxCell><mxCell id="legend-6-text" value="&lt;b&gt;Fulfill in AWS.&lt;/b&gt; The EC2 worker pulls its work the same way and prices and fulfills the order." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1"><mxGeometry x="782" y="1065" width="620" height="40" as="geometry" /></mxCell><mxCell id="legend-7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="1115" width="30" height="30" as="geometry" /></mxCell><mxCell id="legend-7-text" value="&lt;b&gt;Complete.&lt;/b&gt; Both results return; the order completes only when both answer in time." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1"><mxGeometry x="782" y="1110" width="620" height="40" as="geometry" /></mxCell><mxCell id="note-ops" value="Azure Arc manages both workers and the EKS cluster; every stage writes one record with the same correlation ID to Log Analytics; the Health Model rolls those records up to &quot;can customers complete an order?&quot;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="1165" width="640" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
