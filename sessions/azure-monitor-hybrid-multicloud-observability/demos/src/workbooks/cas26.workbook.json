    {
      "type": 3,
      "name": "usage",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Usage\n| where TimeGenerated > ago(8d)\n| where StartTime >= startofday(ago(7d)) and StartTime < startofday(now())\n| where IsBillable == true\n| summarize GB = sum(Quantity) / 1000 by DataType, bin(StartTime, 1d)",
        "size": 0,
        "title": "Workspace ingestion by table (GB/day, last 7 days)",
        "timeContext": {
