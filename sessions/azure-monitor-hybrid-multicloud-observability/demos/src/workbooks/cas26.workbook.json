    {
      "type": 3,
      "name": "guestCpuPromql",
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Infrastructure"
      },
      "customWidth": "50",
      "content": {
        "version": "KqlItem/1.0",
        "query": "100 * (1 - (sum by (\"Microsoft.resourceid\") (rate({\"system.cpu.time\", state=\"idle\"}[15m])) / sum by (\"Microsoft.resourceid\") (rate({\"system.cpu.time\"}[15m]))))",
        "size": 0,
        "title": "Supporting compute CPU % — PromQL (Azure Monitor workspace)",
        "timeContextFromParameter": "TimeRange",
        "queryType": 102,
        "resourceType": "microsoft.monitor/accounts",
        "resourceIds": [
          "${metrics_workspace_id}"
        ],
        "visualization": "linechart"
      }
    },
