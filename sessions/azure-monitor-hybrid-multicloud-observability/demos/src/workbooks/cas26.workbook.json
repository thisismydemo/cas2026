      },
      "customWidth": "50",
      "content": {
        "version": "KqlItem/1.0",
        "query": "sum by (\"Microsoft.resourceid\") ({\"system.memory.usage\", state=\"free\"}) / (1024 * 1024)",
        "size": 0,
        "title": "Free memory (MiB) — PromQL (Azure Monitor workspace)",
        "timeContextFromParameter": "TimeRange",
        "queryType": 102,
        "resourceType": "microsoft.monitor/accounts",
        "resourceIds": [
          "${metrics_workspace_id}"
        ],
