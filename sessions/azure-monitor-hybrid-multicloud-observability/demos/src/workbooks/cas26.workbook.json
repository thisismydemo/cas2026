      }
    },
    {
      "type": 3,
      "name": "heartbeat",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Heartbeat\n| where TimeGenerated {TimeRange}\n| where Computer startswith 'cas26-' or Computer startswith 'iic-' or Computer startswith 'tplabs-01-' or Computer startswith 'EC2AMAZ' or Computer startswith 'ip-10-61'\n| summarize LastHeartbeat = max(TimeGenerated), Agent = any(Category), OS = any(OSType) by Computer\n| extend MinutesAgo = datetime_diff('minute', now(), LastHeartbeat)\n| extend Location = case(Computer startswith 'iic-' or Computer startswith 'EC2AMAZ', 'AWS (EC2)', Computer startswith 'ip-10-61', 'AWS (EKS node)', 'On-premises')\n| project Location, Computer, OS, MinutesAgo, LastHeartbeat\n| order by Location asc, Computer asc",
        "size": 0,
        "title": "Reporting machines — on-premises, AWS and EKS",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "MinutesAgo",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "<=",
                    "thresholdValue": "5",
                    "representation": "success",
                    "text": "{0} min"
                  },
                  {
                    "operator": "<=",
                    "thresholdValue": "15",
                    "representation": "2",
                    "text": "{0} min"
                  },
                  {
                    "operator": "Default",
                    "representation": "4",
                    "text": "{0} min"
                  }
                ]
              }
            }
          ]
        }
      },
      "customWidth": "50",
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Infrastructure"
      }
    },
    {
      "type": 3,
      "name": "vmInsightsCpu",
      "content": {
        "version": "KqlItem/1.0",
        "query": "InsightsMetrics\n| where TimeGenerated {TimeRange}\n| where Namespace == 'Processor' and Name == 'UtilizationPercentage'\n| summarize CpuPercent = avg(Val) by Computer, bin(TimeGenerated, {TimeRange:grain})",
        "size": 0,
        "title": "CPU % by machine — VM insights",
        "timeContext": {
          "durationMs": 0
