    {
      "type": 3,
      "name": "probe",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated > ago(10m)\n| where Environment == '{Environment}'\n| summarize Rows = count(), Orders = dcount(CorrelationId), LastRow = max(TimeGenerated) by Cloud, Component\n| extend Coverage = iff(Orders > 0, 'Reporting', 'Missing')\n| order by Cloud asc",
        "size": 0,
        "title": "Order-completion evidence and three-plane coverage (last 10 min)",
        "timeContext": {
          "durationMs": 0
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
