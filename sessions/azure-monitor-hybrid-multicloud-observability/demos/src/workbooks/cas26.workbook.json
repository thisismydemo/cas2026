            "style": "link"
          }
        ]
      }
    },
    {
      "type": 3,
      "name": "kpis",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n| where Component == 'Coordinator' and Stage in ('Completed','Failed','TimedOut')\n| summarize Orders = count(), Completed = countif(Stage == 'Completed' and Success), Failed = countif(Stage == 'Failed'),\n            TimedOut = countif(Stage == 'TimedOut'), P95Ms = percentile(iff(Stage == 'Completed', DurationMs, long(null)), 95)\n| extend SuccessPercent = round(100.0 * Completed / iff(Orders == 0, 1, Orders), 1)\n| project Orders, SuccessPercent, Completed, Failed, TimedOut, P95Seconds = round(P95Ms / 1000.0, 1)",
        "size": 0,
        "title": "Order outcome",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "tiles",
        "tileSettings": {
          "showBorder": true,
          "titleContent": {
            "columnMatch": "Orders"
          }
        }
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Overview"
      }
    },
    {
      "type": 3,
      "name": "outcomesOverTime",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n| where Component == 'Coordinator' and Stage in ('Completed','Failed','TimedOut')\n| summarize count() by Stage, bin(TimeGenerated, {TimeRange:grain})",
        "size": 0,
        "title": "Orders by outcome",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "barchart"
      },
      "customWidth": "60",
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Overview"
      }
    },
    {
      "type": 3,
      "name": "failuresByComponent",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n| where Success == false\n| summarize Failures = count(), LastSeen = max(TimeGenerated) by Cloud, Component, Stage, FailureMode = iff(isempty(FailureMode), '(none)', FailureMode)\n| order by Failures desc",
        "size": 0,
        "title": "What failed — by component and fault",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "table"
      },
      "customWidth": "40",
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Overview"
      }
    },
    {
      "type": 3,
      "name": "latencyByCloud",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n| where Stage in ('Completed','Failed') and Component != 'Coordinator'\n| summarize P95 = percentile(DurationMs, 95) by Plane = strcat(Cloud, ' · ', Component), bin(TimeGenerated, {TimeRange:grain})",
        "size": 0,
        "title": "Stage duration by execution plane (p95, ms)",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "timechart"
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Overview"
      }
    },
    {
      "type": 3,
      "name": "recentOrders",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n| where Component == 'Coordinator'\n| summarize Placed = min(TimeGenerated), Final = anyif(Stage, Stage in ('Completed','Failed','TimedOut')),\n            DurationMs = maxif(DurationMs, Stage in ('Completed','Failed','TimedOut')), Origin = anyif(Origin, Stage == 'Accepted'),\n            DemoTag = any(DemoTag) by CorrelationId, OrderNumber\n| join kind=leftouter (Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n    | where FailureMode != '' | summarize FailureMode = any(FailureMode) by CorrelationId) on CorrelationId\n| project Placed, OrderNumber, Status = iff(isempty(Final), 'Pending', Final), Seconds = round(DurationMs / 1000.0, 1),\n          FailureMode, DemoTag, Origin, CorrelationId\n| order by Placed desc\n| take 200",
        "size": 0,
        "title": "Recent orders (select a row to see its journey)",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "table",
        "exportFieldName": "CorrelationId",
        "exportParameterName": "CorrelationId",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Completed",
                    "representation": "success",
                    "text": "{0}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Pending",
                    "representation": "pending",
                    "text": "{0}"
                  },
                  {
                    "operator": "Default",
                    "representation": "failed",
                    "text": "{0}"
                  }
                ]
              }
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Order journey"
      }
    },
    {
      "type": 3,
      "name": "journey",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated > ago(7d)\n| where CorrelationId == '{CorrelationId}'\n| project TimeGenerated, OrderNumber, Cloud, Component, Stage, Success, DurationMs, FailureMode, Origin, Computer, Message\n| order by TimeGenerated asc",
        "size": 0,
        "title": "Order journey — every stage for the selected correlation ID",
        "timeContext": {
          "durationMs": 604800000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "table"
      },
      "conditionalVisibility": {
        "parameterName": "CorrelationId",
        "comparison": "isNotEqualTo",
        "value": ""
      }
    },
    {
      "type": 1,
      "name": "journeyHint",
      "content": {
        "json": "_Select an order above (or paste a correlation ID in the filter) to show its full journey across Azure, on-premises and AWS._"
      }
    },
    {
      "type": 3,
      "name": "stageCounts",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n| summarize Results = count(), Failures = countif(Success == false), P50Ms = percentile(DurationMs, 50), P95Ms = percentile(DurationMs, 95)\n          by Cloud, Component, Stage\n| order by Cloud asc, Component asc",
        "size": 0,
        "title": "Stage results by plane and component",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${logs_workspace_id}"
        ],
        "visualization": "table"
      },
      "customWidth": "60",
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Clouds and components"
      }
    },
    {
      "type": 3,
      "name": "workerHeartbeat",
      "content": {
        "version": "KqlItem/1.0",
        "query": "Cas26Service_CL\n| where TimeGenerated {TimeRange}\n| where Environment == '{Environment}'\n| where Stage == 'Started'\n| summarize Started = count() by Component, bin(TimeGenerated, 5m)",
        "size": 0,
        "title": "Worker activity (orders started per 5 min)",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
